# Server Configuration
HOST=0.0.0.0
PORT=8000
SERVER_NAME=HostTerminalBridge
PUBLIC_URL=https://host.vpjoshi.in

# Gemini MCP OAuth Credentials
OAUTH_CLIENT_ID=joshilab-client
OAUTH_CLIENT_SECRET=joshilab-secret-2026

# Enable or disable nsenter execution
# 1 = use nsenter (default in Docker container)
# 0 = run commands directly with shell (useful for local dev/testing)
USE_NSENTER=1
